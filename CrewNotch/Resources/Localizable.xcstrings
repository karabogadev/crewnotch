    "Reads Claude Code's sign-in from the keychain (macOS asks once).": {
      "comment": "Text describing Claude Code's usage source.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ تسجيل دخول Claude Code من سلسلة المفاتيح (سيسأل macOS مرة واحدة)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el inicio de sesión de Claude Code desde el llavero (macOS lo pide una vez)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la connexion de Claude Code dans le trousseau (macOS le demande une fois)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन से Claude Code का साइन-इन पढ़ता है (macOS एक बार पूछेगा)।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンから Claude Code のサインイン情報を読み取ります（macOS が一度確認します）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o login do Claude Code nas Chaves (o macOS pergunta uma vez)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает вход Claude Code из Связки ключей (macOS спросит один раз)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code oturumunu Anahtar Zinciri'nden okur (macOS bir kez sorar)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从钥匙串读取 Claude Code 的登录信息（macOS 会询问一次）。"
          }
        }
      }
    },
    "Reads Claude Code's sign-in from the keychain. macOS asks once: choose Always Allow.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ بيانات تسجيل دخول Claude Code من سلسلة المفاتيح. يسأل macOS مرة واحدة: اختر «السماح دائمًا»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el inicio de sesión de Claude Code desde el llavero. macOS lo pregunta una vez: elige “Permitir siempre”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la connexion de Claude Code depuis le trousseau. macOS le demande une seule fois : choisissez « Toujours autoriser »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन से Claude Code का साइन-इन पढ़ता है। macOS एक बार पूछता है: “हमेशा अनुमति दें” चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンから Claude Code のサインイン情報を読み取ります。macOS で一度だけ確認されるので、「常に許可」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o início de sessão do Claude Code nas Chaves. O macOS pergunta uma vez: escolha “Sempre Permitir”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считывает данные входа Claude Code из Связки ключей. macOS спросит один раз: выберите «Всегда разрешать»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code giriş bilgilerini Anahtar Zinciri'nden okur. macOS bir kez sorar: Her Zaman İzin Ver'i seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从钥匙串读取 Claude Code 的登录信息。macOS 会询问一次：请选择“始终允许”。"
          }
        }
      }
    },
