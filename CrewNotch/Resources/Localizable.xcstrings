    "“When I'm away” sends only after this long without using the Mac, or while the screen is locked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل خيار «في غيابي» فقط بعد عدم استخدام Mac لهذه المدة، أو أثناء قفل الشاشة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Cuando estoy ausente” solo envía tras este tiempo sin usar el Mac o con la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« En mon absence » n’envoie qu’après ce délai sans utiliser le Mac, ou quand l’écran est verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“जब मैं दूर रहूँ” सिर्फ़ तभी भेजता है जब Mac इतनी देर इस्तेमाल न हुआ हो या स्क्रीन लॉक हो।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「離席中」は、Mac をこの時間使わなかったとき、または画面がロックされているときにだけ送信されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Quando estou ausente” só envia após esse tempo sem usar o Mac ou com a tela bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вариант «Когда меня нет» отправляет уведомления, только если Mac не используется столько времени или экран заблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uzaktayken” yalnızca Mac'i bu süre boyunca kullanmadığında ya da ekran kilitliyken gönderir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我离开时”仅在你这么久未使用 Mac 或屏幕锁定时发送。"
          }
        }
      }
    },
