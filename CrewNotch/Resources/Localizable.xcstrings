    "Asks the running Antigravity app on this Mac. Nothing leaves your Mac.": {
      "comment": "Text displayed in the warning banner at the top of the screen when the user is not a member.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل تطبيق Antigravity المفتوح على هذا الـ Mac. لا يغادر أي شيء جهازك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la app Antigravity abierta en este Mac. Nada sale de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge l’app Antigravity ouverte sur ce Mac. Rien ne quitte votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर चल रहे Antigravity से पूछता है। कुछ भी आपके Mac से बाहर नहीं जाता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で実行中の Antigravity に問い合わせます。データは Mac の外に出ません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta o app Antigravity aberto neste Mac. Nada sai do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает запущенный Antigravity на этом Mac. Данные не покидают Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te açık olan Antigravity'ye sorar. Hiçbir şey Mac'inden çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问此 Mac 上正在运行的 Antigravity。数据不会离开你的 Mac。"
          }
        }
      }
    },
