    "Works from any app. The shortcuts act on the oldest request, marked in the panel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل من أي تطبيق. تنطبق الاختصارات على أقدم طلب، وهو مميَّز في اللوحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona desde cualquier app. Los atajos actúan sobre la solicitud más antigua, marcada en el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne depuis n’importe quelle app. Les raccourcis agissent sur la demande la plus ancienne, signalée dans le panneau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी ऐप से काम करता है। शॉर्टकट सबसे पुराने अनुरोध पर लागू होते हैं, जो पैनल में चिह्नित होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでも使えます。ショートカットは、パネルでマークされている最も古いリクエストに対して動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona em qualquer app. Os atalhos agem na solicitação mais antiga, marcada no painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает в любом приложении. Сочетания действуют на самый старый запрос, он отмечен в панели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamada çalışır. Kestirmeler, panelde işaretli olan en eski istek üzerinde çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中都可使用。快捷键作用于最早的请求，该请求会在面板中标出。"
          }
        }
      }
    },
    "Writes directly to a disk": {
