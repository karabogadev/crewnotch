          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para redimensionar. Clique duas vezes para redefinir."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutlandırmak için sürükle. Sıfırlamak için çift tıkla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
