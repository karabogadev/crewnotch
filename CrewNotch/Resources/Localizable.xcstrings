    "One line per provider with the limit you pick. Hover for every limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سطر لكل مزود بالحد الذي تختاره. مرّر المؤشر لرؤية كل الحدود."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea por proveedor con el límite que elijas. Pasa el puntero para ver todos los límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne par fournisseur avec la limite de votre choix. Survolez pour voir toutes les limites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रदाता के लिए एक पंक्ति, आपकी चुनी हुई सीमा के साथ। सभी सीमाएँ देखने के लिए पॉइंटर ले जाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダごとに1行で、選択した上限を表示します。ポインタを置くとすべての上限を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha por provedor com o limite que você escolher. Passe o ponteiro para ver todos os limites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По строке на провайдера с выбранным лимитом. Наведите указатель, чтобы увидеть все лимиты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sağlayıcı için seçtiğin limitle tek satır. Tüm limitler için üzerine gel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个提供商一行，显示你选择的限额。悬停可查看所有限额。"
          }
        }
      }
    },
    "Only needed when Claude Code uses a custom config folder.": {
