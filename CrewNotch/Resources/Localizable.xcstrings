    },
    "You'll get a push like this when an agent needs you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك إشعار كهذا عندما يحتاج إليك أحد الوكلاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un aviso como este cuando un agente te necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez une notification comme celle-ci quand un agent aura besoin de vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब किसी एजेंट को आपकी ज़रूरत होगी, तो आपको ऐसा पुश मिलेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが対応を求めると、このようなプッシュ通知が届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai receber uma notificação como esta quando um agente precisar de você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите такой пуш, когда понадобитесь агенту."
          }
        },
        "tr": {
