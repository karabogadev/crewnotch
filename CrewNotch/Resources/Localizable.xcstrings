    "Deleting files, force-pushing, sudo, running downloaded scripts, editing secrets or files outside the project.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف الملفات، والدفع القسري، وsudo، وتشغيل سكربتات منزّلة، وتعديل الأسرار أو ملفات خارج المشروع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar archivos, forzar un push, sudo, ejecutar scripts descargados, editar secretos o archivos fuera del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer des fichiers, forcer un push, sudo, exécuter des scripts téléchargés, modifier des secrets ou des fichiers hors du projet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें हटाना, फ़ोर्स-पुश, sudo, डाउनलोड की गई स्क्रिप्ट चलाना, सीक्रेट या प्रोजेक्ट के बाहर की फ़ाइलें संपादित करना।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの削除、強制プッシュ、sudo、ダウンロードしたスクリプトの実行、シークレットやプロジェクト外のファイルの編集。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir arquivos, forçar push, sudo, executar scripts baixados, editar segredos ou arquivos fora do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление файлов, принудительный push, sudo, запуск скачанных скриптов, правка секретов или файлов вне проекта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya silme, zorla push etme, sudo, indirilen betikleri çalıştırma, gizli bilgileri ya da proje dışındaki dosyaları düzenleme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除文件、强制推送、sudo、运行下载的脚本、编辑密钥或项目外的文件。"
          }
        }
      }
    },
