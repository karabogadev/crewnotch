    "Uses Claude Code's sign-in from the keychain. macOS asks once: choose Always Allow.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم بيانات تسجيل دخول Claude Code من سلسلة المفاتيح. يسأل macOS مرة واحدة: اختر «السماح دائمًا»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el inicio de sesión de Claude Code del llavero. macOS lo pregunta una vez: elige “Permitir siempre”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la connexion de Claude Code enregistrée dans le trousseau. macOS le demande une seule fois : choisissez « Toujours autoriser »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन से Claude Code के साइन-इन का उपयोग करता है। macOS एक बार पूछता है: “हमेशा अनुमति दें” चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンにある Claude Code のサインイン情報を使用します。macOS で一度だけ確認されるので、「常に許可」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o início de sessão do Claude Code salvo nas Chaves. O macOS pergunta uma vez: escolha “Sempre Permitir”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует данные входа Claude Code из Связки ключей. macOS спросит один раз: выберите «Всегда разрешать»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar Zinciri'ndeki Claude Code girişini kullanır. macOS bir kez sorar: Her Zaman İzin Ver'i seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用钥匙串中 Claude Code 的登录信息。macOS 会询问一次：请选择“始终允许”。"
          }
        }
      }
    },
