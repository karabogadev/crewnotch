    "Delegating sessions get a badge; click it to see what each subagent is doing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحصل الجلسات التي تفوّض المهام على شارة؛ انقر عليها لمعرفة ما يفعله كل وكيل فرعي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones que delegan muestran una insignia; haz clic en ella para ver qué hace cada subagente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions qui délèguent affichent un badge ; cliquez dessus pour voir ce que fait chaque sous-agent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम सौंपने वाले सेशन पर बैज दिखता है; हर सबएजेंट क्या कर रहा है, यह देखने के लिए उस पर क्लिक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを委任しているセッションにはバッジが付きます。クリックすると各サブエージェントの作業内容を確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões que delegam recebem um selo; clique nele para ver o que cada subagente está fazendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансы, делегирующие задачи, получают значок — нажмите его, чтобы увидеть, чем занят каждый субагент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev dağıtan oturumlara bir işaret eklenir; her alt ajanın ne yaptığını görmek için işarete tıkla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "委派任务的会话会显示标记；点按标记即可查看每个子代理在做什么。"
          }
        }
      }
    },
