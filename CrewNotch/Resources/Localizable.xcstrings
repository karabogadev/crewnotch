    "All providers on a single line, each with a ring and a percentage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل المزودين في سطر واحد، لكل منهم حلقة ونسبة مئوية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los proveedores en una sola línea, cada uno con un anillo y un porcentaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fournisseurs sur une seule ligne, chacun avec un anneau et un pourcentage."
