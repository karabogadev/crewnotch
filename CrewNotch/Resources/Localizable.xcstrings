          }
        }
      }
    },
    "Keep Awake is on until %@. Agents keep running while the display sleeps. Click to turn off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع السكون مفعّل حتى %@. يواصل الوكلاء العمل أثناء سكون الشاشة. انقر للإيقاف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener activo está activado hasta %@. Los agentes siguen funcionando mientras la pantalla está en reposo. Haz clic para desactivarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir éveillé est activé jusqu’à %@. Les agents continuent de tourner pendant la suspension de l’écran. Cliquez pour désactiver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जागृत रखें %@ तक चालू है। डिस्प्ले के स्लीप में रहने पर भी एजेंट चलते रहते हैं। बंद करने के लिए क्लिक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止は %@ までオンです。ディスプレイがスリープしてもエージェントは動作し続けます。クリックするとオフになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter Ativo está ativado até %@. Os agentes continuam rodando enquanto a tela repousa. Clique para desativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Не засыпать» включено до %@. Агенты продолжают работать, пока дисплей спит. Нажмите, чтобы выключить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tut %@ saatine kadar açık. Ekran uyurken ajanlar çalışmaya devam eder. Kapatmak için tıkla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持唤醒已开启，直到 %@。显示器睡眠时代理会继续运行。点按以关闭。"
          }
        }
      }
    },
    "Keep Awake is paused: %@. Click to turn off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع السكون متوقف مؤقتًا: %@. انقر للإيقاف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener activo está en pausa: %@. Haz clic para desactivarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir éveillé est en pause : %@. Cliquez pour désactiver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जागृत रखें रुका हुआ है: %@। बंद करने के लिए क्लिक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止は一時停止中です: %@。クリックするとオフになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter Ativo está pausado: %@. Clique para desativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Не засыпать» приостановлено: %@. Нажмите, чтобы выключить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tut duraklatıldı: %@. Kapatmak için tıkla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持唤醒已暂停：%@。点按以关闭。"
          }
        }
      }
    },
    "Keep Awake: keep agents running while the display sleeps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع السكون: إبقاء الوكلاء يعملون أثناء سكون الشاشة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener activo: los agentes siguen funcionando mientras la pantalla está en reposo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir éveillé : les agents continuent de tourner pendant la suspension de l’écran"
