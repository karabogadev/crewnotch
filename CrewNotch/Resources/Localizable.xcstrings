          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Off: pushes only say which agent needs you. On: they include the project, command or message.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف: تذكر الإشعارات الوكيل الذي يحتاج إليك فقط. تشغيل: تتضمن المشروع أو الأمر أو الرسالة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: los avisos solo indican qué agente te necesita. Activado: incluyen el proyecto, el comando o el mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les notifications indiquent seulement quel agent a besoin de vous. Activé : elles incluent le projet, la commande ou le message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद: पुश सिर्फ़ यह बताते हैं कि किस एजेंट को आपकी ज़रूरत है। चालू: उनमें प्रोजेक्ट, कमांड या संदेश भी शामिल होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ: プッシュ通知では対応が必要なエージェント名だけを伝えます。オン: プロジェクト、コマンド、メッセージも含めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: as notificações dizem só qual agente precisa de você. Ativado: incluem o projeto, o comando ou a mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл.: в пушах только имя агента, которому вы нужны. Вкл.: ещё проект, команда или сообщение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: bildirimler yalnızca hangi ajanın seni beklediğini söyler. Açık: proje, komut ya da mesaj da eklenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：推送只说明哪个代理需要你。打开：推送会包含项目、命令或消息。"
          }
        }
      }
    },
