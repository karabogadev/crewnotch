        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी प्रदाता एक ही पंक्ति में, हर एक के साथ रिंग और प्रतिशत।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのプロバイダを1行に表示し、それぞれリングとパーセンテージで示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os provedores em uma única linha, cada um com um anel e uma porcentagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
