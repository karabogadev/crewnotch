    "Couldn't reach %@. Allow CrewNotch in Privacy & Security → Automation.": {
      "comment": "A message that appears when a reply to a message fails. The argument is the name of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى %@. اسمح لـ CrewNotch في الخصوصية والأمن ← الأتمتة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a %@. Permite CrewNotch en Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’atteindre %@. Autorisez CrewNotch dans Confidentialité et sécurité → Automatisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक नहीं पहुँच सका। गोपनीयता और सुरक्षा → स्वचालन में CrewNotch को अनुमति दें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続できません。「プライバシーとセキュリティ」→「オートメーション」で CrewNotch を許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o %@. Permita o CrewNotch em Privacidade e Segurança → Automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с %@. Разрешите CrewNotch в разделе «Конфиденциальность и безопасность» → «Автоматизация»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasına ulaşılamadı. Gizlilik ve Güvenlik → Otomasyon bölümünden CrewNotch'a izin ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@。请在“隐私与安全性”→“自动化”中允许 CrewNotch。"
          }
        }
      }
    },
