    "While agents work, the notch shows the busiest agent's logo and the crew dots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء عمل الوكلاء، يعرض النتوء شعار الوكيل الأكثر انشغالاً ونقاط الفريق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras los agentes trabajan, el notch muestra el logotipo del agente más activo y los puntos del equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que les agents travaillent, le notch affiche le logo de l’agent le plus actif et les points de l’équipe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट के काम करते समय नॉच सबसे व्यस्त एजेंट का लोगो और क्रू डॉट्स दिखाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの作業中は、最も忙しいエージェントのロゴとクルードットがノッチに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto os agentes trabalham, o notch mostra o logotipo do agente mais ativo e os pontos da equipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока агенты работают, вырез показывает логотип самого занятого агента и точки команды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar çalışırken çentik, en yoğun ajanın logosunu ve ekip noktalarını gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理工作时，刘海会显示最忙代理的标志和队员圆点。"
          }
        }
      }
    },
