    "Runs with administrator rights (sudo)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل بصلاحيات المسؤول (sudo)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta con permisos de administrador (sudo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute avec les droits d’administrateur (sudo)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडमिनिस्ट्रेटर अधिकारों के साथ चलता है (sudo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限で実行します（sudo）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa com privilégios de administrador (sudo)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется с правами администратора (sudo)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici yetkileriyle çalışır (sudo)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以管理员权限运行（sudo）"
          }
        }
      }
    },
    "Saves the rule the agent suggests, such as Bash(npm test:*), so it stops asking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ القاعدة التي يقترحها الوكيل، مثل Bash(npm test:*)، حتى يتوقف عن السؤال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la regla que sugiere el agente, como Bash(npm test:*), para que deje de preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la règle suggérée par l’agent, comme Bash(npm test:*), pour qu’il ne demande plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट का सुझाया नियम सेव करता है, जैसे Bash(npm test:*), ताकि वह फिर न पूछे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが提案するルール（Bash(npm test:*) など）を保存し、以後は確認されなくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva a regra que o agente sugere, como Bash(npm test:*), para que ele pare de perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет правило, которое предлагает агент, например Bash(npm test:*), чтобы он больше не спрашивал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın önerdiği kuralı, örneğin Bash(npm test:*), kaydeder; böylece ajan bir daha sormaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存代理建议的规则（例如 Bash(npm test:*)），之后就不会再询问。"
          }
        }
      }
    },
