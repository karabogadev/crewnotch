    "No activity for a while. If the agent is stuck, clear the session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نشاط منذ فترة. إذا كان الوكيل عالقًا، فامسح الجلسة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin actividad desde hace un rato. Si el agente se ha atascado, borra la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité depuis un moment. Si l’agent est bloqué, effacez la session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ समय से कोई गतिविधि नहीं। अगर एजेंट अटक गया है, तो सेशन हटा दें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく動きがありません。エージェントが止まっている場合は、セッションを消去してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem atividade há algum tempo. Se o agente travou, limpe a sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давно нет активности. Если агент завис, уберите сеанс."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süredir hareket yok. Ajan takıldıysa oturumu temizle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
