    "Reads Claude Code's sign-in from the keychain (macOS asks once).": {
      "comment": "Text describing Claude Code's usage source.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ تسجيل دخول Claude Code من سلسلة المفاتيح (سيسأل macOS مرة واحدة)."
          }
        },
        "es": {
