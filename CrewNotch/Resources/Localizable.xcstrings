    "Turn on the providers you use. Drag to reorder, or open one to choose its metrics.": {
      "comment": "Footer text under the list of providers in the Usage",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الخدمات التي تستخدمها. اسحب لإعادة الترتيب، أو افتح إحداها لاختيار مقاييسها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los proveedores que usas. Arrastra para reordenar o abre uno para elegir sus métricas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les services que vous utilisez. Faites glisser pour réordonner, ou ouvrez-en un pour choisir ses mesures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन सेवाओं का आप उपयोग करते हैं उन्हें चालू करें। क्रम बदलने के लिए खींचें, या मेट्रिक्स चुनने के लिए किसी को खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使っているサービスをオンにします。ドラッグで並べ替え、開くと指標を選べます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative os provedores que você usa. Arraste para reordenar ou abra um para escolher as métricas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите сервисы, которыми пользуетесь. Перетащите, чтобы изменить порядок, или откройте, чтобы выбрать метрики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullandığın sağlayıcıları aç. Sıralamak için sürükle, metriklerini seçmek için birini aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启你使用的服务。拖动可重新排序，打开某项可选择其指标。"
          }
        }
      }
    },
    "Turning sounds off or choosing None keeps the visual notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الأصوات أو اختيار «لا شيء» يُبقي الإشعارات المرئية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivar los sonidos o elegir Ninguno, se mantienen las notificaciones visuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver les sons ou choisir Aucun conserve les notifications visuelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्वनियाँ बंद करने या “कोई नहीं” चुनने पर भी दृश्य सूचनाएँ बनी रहती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンドをオフにするか「なし」を選択しても、視覚的な通知は表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar os sons ou escolher Nenhum mantém as notificações visuais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить звуки или выбрать «Нет», визуальные уведомления останутся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesleri kapatmak ya da Yok'u seçmek görsel bildirimleri etkilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭声音或选择“无”仍会保留视觉通知。"
          }
        }
      }
    },
