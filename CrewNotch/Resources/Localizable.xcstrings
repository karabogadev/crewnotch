    "Install the free ntfy app on your phone, then scan this code or subscribe to the topic.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت تطبيق ntfy المجاني على هاتفك، ثم امسح هذا الرمز أو اشترك في الموضوع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la app gratuita ntfy en tu teléfono y escanea este código o suscríbete al tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez l’app gratuite ntfy sur votre téléphone, puis scannez ce code ou abonnez-vous au sujet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ोन पर मुफ़्त ntfy ऐप इंस्टॉल करें, फिर यह कोड स्कैन करें या टॉपिक को सब्सक्राइब करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンに無料の ntfy アプリをインストールし、このコードをスキャンするかトピックを購読してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o app gratuito ntfy no celular e escaneie este código ou assine o tópico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите бесплатное приложение ntfy на телефон, затем отсканируйте этот код или подпишитесь на тему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonuna ücretsiz ntfy uygulamasını yükle, ardından bu kodu tara ya da konuya abone ol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上安装免费的 ntfy App，然后扫描此二维码或订阅该主题。"
