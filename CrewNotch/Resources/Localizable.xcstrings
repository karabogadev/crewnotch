          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ防止: ディスプレイのスリープ中もエージェントを動作させる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter Ativo: os agentes continuam rodando enquanto a tela repousa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засыпать: агенты работают, пока дисплей спит"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
