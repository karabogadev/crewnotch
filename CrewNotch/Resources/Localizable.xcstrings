    "The CrewNotch hook script is missing from the app bundle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سكربت الخطّاف الخاص بـ CrewNotch مفقود من حزمة التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el script de hook de CrewNotch en el paquete de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script de hook de CrewNotch est absent du paquet de l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंडल में CrewNotch हुक स्क्रिप्ट मौजूद नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App バンドルに CrewNotch のフックスクリプトがありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O script de hook do CrewNotch está faltando no pacote do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В пакете приложения отсутствует скрипт хука CrewNotch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CrewNotch kanca betiği uygulama paketinde bulunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 包中缺少 CrewNotch 钩子脚本。"
          }
        }
      }
    },
    "The closed notch always stays black so it blends with the camera housing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى النتوء المغلق أسود دائمًا ليندمج مع إطار الكاميرا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El notch cerrado siempre es negro para integrarse con el alojamiento de la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notch fermé reste toujours noir pour se fondre avec le boîtier de la caméra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद नॉच हमेशा काला रहता है ताकि वह कैमरा हाउसिंग के साथ घुल-मिल जाए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたノッチはカメラ部分になじむよう、常に黒のままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch fechado fica sempre preto para se misturar com o alojamento da câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытый вырез всегда остаётся чёрным, чтобы сливаться с корпусом камеры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı çentik, kamera yuvasıyla bütünleşmesi için her zaman siyah kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起的刘海始终保持黑色，以便与摄像头区域融为一体。"
          }
        }
      }
    },
