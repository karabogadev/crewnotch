    "Press play to preview an animation in the notch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط تشغيل لمعاينة رسم متحرك في النتوء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa reproducir para previsualizar una animación en el notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Lire pour prévisualiser une animation dans le notch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में ऐनिमेशन का प्रीव्यू देखने के लिए चलाएँ दबाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を押すと、ノッチでアニメーションをプレビューできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em reproduzir para pré-visualizar uma animação no notch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Воспроизвести», чтобы просмотреть анимацию в вырезе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir animasyonu çentikte önizlemek için oynat'a bas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下播放即可在刘海中预览动画。"
          }
        }
      }
    },
