    "Press a key with ⌘, ⌃ or ⌥. ⎋ cancels, ⌫ removes the shortcut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مفتاحًا مع ⌘ أو ⌃ أو ⌥. ⎋ للإلغاء، و⌫ لإزالة الاختصار."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una tecla con ⌘, ⌃ o ⌥. ⎋ cancela y ⌫ elimina el atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une touche avec ⌘, ⌃ ou ⌥. ⎋ annule, ⌫ supprime le raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌃ या ⌥ के साथ कोई कुंजी दबाएँ। ⎋ रद्द करता है, ⌫ शॉर्टकट हटाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌃、⌥ のいずれかと一緒にキーを押してください。⎋ でキャンセル、⌫ でショートカットを削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma tecla com ⌘, ⌃ ou ⌥. ⎋ cancela e ⌫ remove o atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу вместе с ⌘, ⌃ или ⌥. ⎋ — отмена, ⌫ — удалить сочетание."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌃ veya ⌥ ile birlikte bir tuşa bas. ⎋ iptal eder, ⌫ kestirmeyi kaldırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下带有 ⌘、⌃ 或 ⌥ 的按键。⎋ 取消，⌫ 移除快捷键。"
          }
        }
      }
    },
    "Press play to preview an animation in the notch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط تشغيل لمعاينة رسم متحرك في النتوء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa reproducir para previsualizar una animación en el notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Lire pour prévisualiser une animation dans le notch."
