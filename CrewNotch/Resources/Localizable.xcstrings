    "Shown in the closed notch and next to sessions while an agent works.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر في النتوء المغلق وبجانب الجلسات أثناء عمل أحد الوكلاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra en el notch cerrado y junto a las sesiones mientras un agente trabaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché dans le notch fermé et à côté des sessions pendant qu’un agent travaille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट के काम करते समय बंद नॉच में और सेशन के बगल में दिखाया जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの作業中、閉じたノッチ内とセッションの横に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibido no notch fechado e ao lado das sessões enquanto um agente trabalha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается в закрытом вырезе и рядом с сеансами, пока агент работает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ajan çalışırken kapalı çentikte ve oturumların yanında gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理工作时显示在收起的刘海中和会话旁边。"
          }
        }
      }
    },
