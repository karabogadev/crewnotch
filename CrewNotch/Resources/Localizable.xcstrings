            "value": "ノッチを隠す"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar o notch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть вырез"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentiği gizle"
          }
        },
        "zh-Hans": {
