            "state": "translated",
            "value": "隐藏刘海"
          }
        }
      }
    },
    "Hover or click the notch to see every session, grouped by project.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر المؤشر فوق النتوء أو انقر عليه لرؤية كل الجلسات مجمّعة حسب المشروع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el puntero o haz clic en el notch para ver todas las sesiones, agrupadas por proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez ou cliquez sur le notch pour voir toutes les sessions, groupées par projet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट के अनुसार समूहित सभी सेशन देखने के लिए नॉच पर पॉइंटर ले जाएँ या क्लिक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにポインタを置くかクリックすると、プロジェクトごとにグループ化されたすべてのセッションが表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o ponteiro ou clique no notch para ver todas as sessões, agrupadas por projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на вырез или нажмите его, чтобы увидеть все сеансы, сгруппированные по проектам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeye göre gruplanmış tüm oturumları görmek için çentiğin üzerine gel ya da tıkla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针悬停在刘海上或点按刘海，即可查看按项目分组的所有会话。"
          }
        }
      }
    },
