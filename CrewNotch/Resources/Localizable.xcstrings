    "When a turn finishes, the notch drops down for a moment. Click it to go back to the session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند انتهاء دور، ينسدل النتوء للحظة. انقر عليه للعودة إلى الجلسة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando termina un turno, el notch se despliega un momento. Haz clic en él para volver a la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un tour se termine, le notch se déploie un instant. Cliquez dessus pour revenir à la session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई टर्न पूरा होता है, तो नॉच कुछ पल के लिए नीचे खुलता है। सेशन पर वापस जाने के लिए उस पर क्लिक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンが完了すると、ノッチが一瞬開きます。クリックするとそのセッションに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um turno termina, o notch desce por um instante. Clique nele para voltar à sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ход завершается, вырез ненадолго раскрывается. Нажмите его, чтобы вернуться к сеансу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tur bittiğinde çentik kısa bir süreliğine aşağı açılır. Oturuma dönmek için tıkla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一轮对话完成时，刘海会短暂展开。点按即可返回该会话。"
          }
        }
      }
    },
    "When idle": {
