    "macOS asks once to read Claude Code's sign-in: choose Always Allow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب macOS مرة واحدة قراءة بيانات تسجيل دخول Claude Code: اختر «السماح دائمًا»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide una vez permiso para leer el inicio de sesión de Claude Code: elige “Permitir siempre”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande une seule fois l’autorisation de lire la connexion de Claude Code : choisissez « Toujours autoriser »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Claude Code का साइन-इन पढ़ने के लिए एक बार पूछता है: “हमेशा अनुमति दें” चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code のサインイン情報の読み取りについて macOS で一度だけ確認されます。「常に許可」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pede uma vez para ler o início de sessão do Claude Code: escolha “Sempre Permitir”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS один раз запросит доступ к данным входа Claude Code: выберите «Всегда разрешать»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Claude Code girişini okumak için bir kez izin ister: Her Zaman İzin Ver'i seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会询问一次是否读取 Claude Code 的登录信息：请选择“始终允许”。"
          }
        }
      }
    },
