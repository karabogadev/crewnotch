    "Run any long command through crewnotch to see it in the notch and hear when it's done: crewnotch run npm test": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل أي أمر طويل عبر crewnotch لتراه في النتوء وتسمع تنبيهًا عند انتهائه: crewnotch run npm test"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta cualquier comando largo a través de crewnotch para verlo en el notch y oír cuándo termina: crewnotch run npm test"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une commande longue via crewnotch pour la voir dans le notch et entendre quand elle se termine : crewnotch run npm test"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी लंबे कमांड को crewnotch के ज़रिए चलाएँ ताकि वह नॉच में दिखे और पूरा होने पर आवाज़ सुनाई दे: crewnotch run npm test"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間のかかるコマンドを crewnotch 経由で実行すると、ノッチに表示され、完了時に音で知らせます: crewnotch run npm test"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute qualquer comando demorado pelo crewnotch para vê-lo no notch e ouvir quando terminar: crewnotch run npm test"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте долгие команды через crewnotch, чтобы видеть их в вырезе и слышать, когда они завершатся: crewnotch run npm test"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun süren herhangi bir komutu crewnotch üzerinden çalıştır; çentikte gör ve bittiğinde duy: crewnotch run npm test"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 crewnotch 运行任何耗时较长的命令，即可在刘海中查看它，并在完成时听到提示音：crewnotch run npm test"
          }
        }
      }
    },
    "Runs a script downloaded from the internet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل سكربتًا منزّلًا من الإنترنت"
