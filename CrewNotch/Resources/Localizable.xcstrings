    "Drag to reorder. Turn a provider off to hide it, or open it to choose its metrics.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لإعادة الترتيب. أوقف مزودًا لإخفائه، أو افتحه لاختيار مقاييسه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva un proveedor para ocultarlo, o ábrelo para elegir sus métricas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Désactivez un fournisseur pour le masquer, ou ouvrez-le pour choisir ses mesures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए ड्रैग करें। किसी प्रदाता को छिपाने के लिए उसे बंद करें, या उसके मेट्रिक चुनने के लिए उसे खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。プロバイダをオフにすると非表示になり、開くと表示する指標を選択できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Desative um provedor para ocultá-lo ou abra-o para escolher suas métricas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Выключите провайдера, чтобы скрыть его, или откройте, чтобы выбрать метрики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamak için sürükle. Bir sağlayıcıyı gizlemek için kapat, metriklerini seçmek için aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。关闭某个提供商可将其隐藏，打开它可选择其指标。"
          }
        }
      }
    },
    "Drag to resize. Double-click to reset.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整大小，双击恢复默认。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
